    given-names: "Pablo"
    affiliation: "Matrix CR Studio"
version: "0.1.0"
date-released: "2026-10-31"
license: "PolyForm-Noncommercial-1.0.0"
repository-code: "https://github.com/pabl0ramirez/augur"
keywords:
  - quantum computing
  - quantum simulation
  - matrix product states
  - Pauli propagation
  - tensor networks
  - Qiskit
  - uncertainty quantification
